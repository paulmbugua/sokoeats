# --- never upload ---
.git/
**/.git/

# local caches / outputs
**/node_modules/
**/.expo/
**/.expo-shared/
**/.cache/
**/.cxx/
**/*.log
**/*.tsbuildinfo
**/web-build/
**/dist/
**/build/

# local env files (use EAS env vars instead)
**/.env
**/.env.*
!**/.env.example

# prebuild outputs (you don't commit them anyway)
apps/mobile/android/
apps/mobile/ios/

# backend uploads/secrets
apps/backend/uploads/
apps/backend/secrets/

# --- MUST be included for Yarn 4 workspace installs ---
!package.json
!yarn.lock
!.yarnrc.yml
!.yarn/**
!.pnp.cjs
!.pnp.loader.mjs

# --- MUST be included for mobile build ---
!apps/mobile/**
!packages/shared/**
