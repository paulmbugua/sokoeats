# --- never upload ---
.git/
**/.git/

# local caches / outputs
**/node_modules/
**/.expo/
**/.expo-shared/
**/.cache/
**/dist/
**/build/
**/.cxx/
**/*.log
**/*.tsbuildinfo
**/web-build/

# prebuild outputs (you don't commit them anyway)
apps/mobile/android/
apps/mobile/ios/

# backend uploads/secrets
apps/backend/uploads/
apps/backend/secrets/

# --- DO NOT exclude workspace manifests ---
# (Do NOT ignore apps/web, apps/backend, etc. at all.)
# You can ignore only their heavy outputs, which we already do above.

# --- MUST be included for Yarn 4 workspace installs ---
!package.json
!yarn.lock
!.yarnrc.yml
!.yarn/**

# --- MUST be included for mobile build ---
!apps/mobile/**
!packages/shared/**
