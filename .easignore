# --- never upload ---
.git/
**/.git/

# outputs / caches
**/node_modules/
**/.expo/
**/.expo-shared/
**/.cache/
**/.cxx/
**/*.log
**/*.tsbuildinfo
**/web-build/
**/dist/
**/build/
**/.next/
**/.turbo/
**/coverage/

# env files
**/.env
**/.env.*
!**/.env.example

# backend secrets/uploads
apps/backend/uploads/
apps/backend/secrets/

# Yarn essentials
!package.json
!yarn.lock
!.yarnrc.yml
!.yarn/**
!.pnp.cjs
!.pnp.loader.mjs

# Don't upload Yarn cache blobs
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml

# Mobile + shared only
!apps/
!apps/mobile/**
!packages/
!packages/shared/**

# Never upload prebuild folders
apps/mobile/android/
apps/mobile/ios/
