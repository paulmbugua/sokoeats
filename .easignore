# -------------------------------
# DO NOT ignore Yarn core files
# -------------------------------
!.yarnrc.yml
!.yarn/releases/**
!yarn.lock
!package.json
!turbo.json
!tsconfig*.json

# Keep workspace sources needed by the mobile app
!apps/mobile/**
!packages/shared/**

# -------------------------------
# Ignore heavy / irrelevant stuff
# -------------------------------

# Node deps (EAS will install)
node_modules/

# Local caches
.expo/
.expo-shared/
.cache/
.turbo/
turbo/
**/.cxx/
**/build/

# Mobile build output (generated)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/
apps/mobile/web-build/

# Web/Next/admin/backend apps: exclude entirely
apps/web/**
apps/web-next/**
apps/admin/**
apps/backend/**

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
serviceAccount.json
firebase-adminsdk-*.json
**/serviceAccount.json
**/firebase-adminsdk-*.json

# IDE / OS
.vscode/
.idea/
.DS_Store
