{
  "name": "sokoeats",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build:all": "yarn workspaces run build",
    "start": "yarn workspace @sokoeats/backend start",
    "start:backend": "yarn workspace @sokoeats/backend start",
    "dev:web": "yarn workspace @sokoeats/web dev",
    "dev:admin": "yarn workspace @sokoeats/admin dev",
    "dev:admin-tickets": "yarn workspace @sokoeats/admin-tickets dev",
    "dev:admin-vendor": "yarn workspace @sokoeats/admin-vendor dev",
    "dev:admin-support": "yarn workspace @sokoeats/admin-support dev",
    "dev:mobile": "yarn workspace @sokoeats/mobile dev",
    "android": "yarn workspace @sokoeats/mobile android",
    "ios": "yarn workspace @sokoeats/mobile ios",
    "build": "turbo run build --filter=@sokoeats/backend... --filter=@sokoeats/web... --filter=@sokoeats/admin... --filter=@sokoeats/admin-tickets... --filter=@sokoeats/admin-vendor... --filter=@sokoeats/admin-support...",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:setup": "yarn workspace @sokoeats/backend db:setup"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "postcss": "^8.4.21",
    "prettier": "^3.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "serve": "^14.2.4",
    "tailwindcss": "^3.3.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vite": "4.5.9"
  },
  "dependencies": {
    "@tanstack/react-query": "5.89.0",
    "firebase-admin": "^13.5.0"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.0.3"
  }
}
