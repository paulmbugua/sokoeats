# --------------------------------
# Global ignores
# --------------------------------

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / IDE
.DS_Store
.vscode/
.idea/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/

# --------------------------------
# Build outputs / caches
# --------------------------------

# Next.js
.next/
out/
apps/web-next/.next/
apps/web-next/out/

# Vite / general dist
dist/
**/dist/
web-build/

# Turborepo / Vercel
.turbo/
turbo/
.vercel/

# Expo
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*

# Native build artifacts
build/
**/build/
.cxx/
**/.cxx/

# Android / iOS generated by prebuild (you said you don’t want committed)
apps/mobile/android/
apps/mobile/ios/

# Yarn integrity (optional)
.yarn-integrity

# --------------------------------
# Environment files (DO NOT COMMIT)
# --------------------------------
.env
.env.*
.env.*.local
.env.local

# Monorepo env files
apps/**/.env
apps/**/.env.*
packages/**/.env
packages/**/.env.*
!.env.example
!apps/**/.env.example
!packages/**/.env.example

# --------------------------------
# Secrets / credentials (DO NOT COMMIT)
# --------------------------------

# Keystores / certs / keys
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# Firebase / Google service accounts
serviceAccount.json
**/serviceAccount.json
firebase-adminsdk-*.json
**/firebase-adminsdk-*.json
*google-service-account*.json
**/*google-service-account*.json

# Your backend secrets directory (this is where the leaked private key JSON was)
apps/backend/secrets/
apps/backend/secrets/**

# If you ever store secrets at repo root
secrets/
secrets/**

# --------------------------------
# User uploads / generated media (DO NOT COMMIT)
# --------------------------------
apps/backend/uploads/
apps/backend/uploads/**

# Firebase mobile config (do not commit)
apps/mobile/google-services.json
apps/mobile/GoogleService-Info.plist
apps/mobile/GoogleService-Info


# If you generate exports/media anywhere else, add them explicitly:
# apps/**/uploads/
# apps/**/exports/
# packages/**/exports/

.yarn/install-state.gz
