# Core runtime
PORT=4005
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
FINANCE_DATA_KEY=
DELIVERY_OTP_SECRET=replace-with-a-long-random-secret

# Paystack collections, recipients, transfers, and refunds
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Safaricom Daraja collections and reversals
MPESA_ENV=live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.example.com/api/mpesa/callback
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_REVERSAL_RESULT_URL=https://api.example.com/api/finance/mpesa/refund-callback
MPESA_REVERSAL_TIMEOUT_URL=https://api.example.com/api/finance/mpesa/refund-callback

# Settlement scheduler. Enable auto execution only after PSP production approval.
SETTLEMENT_WORKER_ENABLED=true
SETTLEMENT_SWEEP_MS=60000
AUTO_EXECUTE_PAYOUTS=false

# Live route pricing. Restrict this server key to Routes and Geocoding APIs.
GOOGLE_MAPS_SERVER_API_KEY=
SOKOEATS_DELIVERY_PER_KM=35
SOKOEATS_SERVICE_FEE_BPS=400
SOKOEATS_COMMISSION_BPS=1000
SOKOEATS_PRICING_VERSION=ke-launch-2026-01
