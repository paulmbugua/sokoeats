# Core runtime
PORT=4000
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
FINANCE_DATA_KEY=
DELIVERY_OTP_SECRET=replace-with-a-long-random-secret
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
WEB_RETURN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177
# apps/web OAuth code flow. The secret must belong to this exact web client.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET=
# apps/mobile ID-token audience: Firebase's Web OAuth client (default_web_client_id).
FIREBASE_GOOGLE_WEB_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Paystack collections, recipients, transfers, and refunds
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://app.sokoeats.co.ke/checkout/payment-return
# Configure this exact URL in the Paystack dashboard. It receives signed charge,
# transfer, and refund events for both card and M-PESA Paystack channels.
PAYSTACK_WEBHOOK_URL=https://server.sokoeats.co.ke/api/payments/paystack/webhook
SOKOEATS_ALLOW_PAYMENT_SIMULATION=false

# Settlement scheduler. Enable auto execution only after PSP production approval.
SETTLEMENT_WORKER_ENABLED=true
SETTLEMENT_SWEEP_MS=60000
AUTO_EXECUTE_PAYOUTS=false
RIDER_IMMEDIATE_MINIMUM=1500
VENDOR_SAME_DAY_CUTOFF_HOUR=21

# Live route pricing. Restrict this server key to Routes and Geocoding APIs.
GOOGLE_MAPS_SERVER_API_KEY=
SOKOEATS_MINIMUM_ORDER=300
SOKOEATS_SMALL_ORDER_FEE=50
SOKOEATS_DELIVERY_BASE_FEE=100
SOKOEATS_DELIVERY_MINIMUM_FEE=150
SOKOEATS_DELIVERY_INCLUDED_KM=2
SOKOEATS_DELIVERY_PER_KM=35
SOKOEATS_DELIVERY_INCLUDED_MINUTES=15
SOKOEATS_DELIVERY_PER_MINUTE=3
SOKOEATS_SERVICE_FEE_BPS=400
SOKOEATS_COMMISSION_BPS=1000
SOKOEATS_VAT_REGISTERED=false
SOKOEATS_PRICING_VERSION=ke-route-tax-2026-02

# Terms identity. Bump TERMS_VERSION whenever published legal content changes.
SOKOEATS_LEGAL_ENTITY="EkaziConnect Solutions Ltd"
SOKOEATS_LEGAL_ADDRESS="International Hse, 2nd flr, Rm12"
SOKOEATS_LEGAL_EMAIL=support@sokoeats.co.ke

# Transactional email. The authenticated SMTP account must be permitted to send
# as MAIL_FROM_ADDRESS by the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=SokoEats
MAIL_FROM_ADDRESS=support@sokoeats.co.ke
MAIL_REPLY_TO=support@sokoeats.co.ke
STORE_OPERATIONS_URL=https://sokoeats.co.ke
EMAIL_OUTBOX_SWEEP_MS=60000
SOKOEATS_ALLOW_GLOBAL_TEST_LOCATIONS=false
