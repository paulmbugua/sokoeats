{
  "cli": {
    "version": ">= 16.7.2",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "environment": "development",
      "node": "20.19.4",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_DEFAULT_BACKEND": "lan1",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "preview": {
      "environment": "preview",
      "node": "20.19.4",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_DEFAULT_BACKEND": "prod",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "production": {
      "environment": "production",
      "node": "20.19.4",
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_DEFAULT_BACKEND": "prod",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "557799973381-ksp83t2vo6fdqufhm0iie06lnb4e8j8v.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "557799973381-g0h98g6vg82oeineeb4t9e67hgosdfrg.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_REVERSED_CLIENT_ID": "com.googleusercontent.apps.557799973381-g0h98g6vg82oeineeb4t9e67hgosdfrg",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "557799973381-97lsoficotiiulhl5st6tf6h723uurpg.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
