FROM node:22-alpine AS builder
WORKDIR /workspace
RUN corepack enable
COPY package.json yarn.lock .yarnrc.yml tsconfig*.json ./
COPY .yarn/releases .yarn/releases
COPY apps apps
COPY packages packages
RUN yarn install --immutable
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ANDROID_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_ANDROID_APP_URL=$NEXT_PUBLIC_ANDROID_APP_URL
RUN yarn workspace @sokoeats/web build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /workspace
RUN apk add --no-cache tini && addgroup -S sokoeats && adduser -S -G sokoeats sokoeats
COPY --from=builder --chown=sokoeats:sokoeats /workspace/apps/web/.next/standalone ./
COPY --from=builder --chown=sokoeats:sokoeats /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=sokoeats:sokoeats /workspace/apps/web/public ./apps/web/public
USER sokoeats
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
