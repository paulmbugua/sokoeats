FROM node:22-alpine AS dependencies
WORKDIR /workspace
RUN corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY apps apps
COPY packages packages
RUN yarn install --immutable

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /workspace
RUN apk add --no-cache tini && addgroup -S sokoeats && adduser -S -G sokoeats sokoeats
COPY --from=dependencies --chown=sokoeats:sokoeats /workspace/node_modules ./node_modules
COPY --from=dependencies --chown=sokoeats:sokoeats /workspace/apps/backend/node_modules ./apps/backend/node_modules
COPY --chown=sokoeats:sokoeats package.json ./package.json
COPY --chown=sokoeats:sokoeats apps/backend ./apps/backend
USER sokoeats
EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/backend/server.js"]
