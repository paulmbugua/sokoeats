FROM node:22-alpine AS builder
WORKDIR /workspace
RUN corepack enable
COPY package.json yarn.lock .yarnrc.yml tsconfig*.json ./
COPY .yarn/releases .yarn/releases
COPY apps apps
COPY packages packages
RUN yarn install --immutable
ARG APP_WORKSPACE
ARG APP_DIRECTORY
ARG VITE_API_URL
ARG VITE_BACKEND_URL
ARG VITE_SITE_URL
ARG VITE_IMAGES_BASE_URL
ENV VITE_API_URL=$VITE_API_URL \
    VITE_BACKEND_URL=$VITE_BACKEND_URL \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_IMAGES_BASE_URL=$VITE_IMAGES_BASE_URL
RUN yarn workspace "$APP_WORKSPACE" build && cp -R "$APP_DIRECTORY/dist" /spa-dist

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/hostpinnacle/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /spa-dist /usr/share/nginx/html
EXPOSE 8080
